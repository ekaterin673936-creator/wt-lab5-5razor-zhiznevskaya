@page
@model wt_lab5_5razor_zhiznevskaya.Pages.Cars.DetailsModel
@{
    ViewData["Title"] = "Информация об автомобиле";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <span class="badge bg-secondary mb-3">ID: @Model.Car!.Id</span>
                    <h2 class="fw-bold mb-4">@Model.Car.Brand @Model.Car.Model</h2>

                    <dl class="row">
                        <dt class="col-sm-5">Марка</dt>
                        <dd class="col-sm-7">@Model.Car.Brand</dd>

                        <dt class="col-sm-5">Модель</dt>
                        <dd class="col-sm-7">@Model.Car.Model</dd>

                        <dt class="col-sm-5">Год выпуска</dt>
                        <dd class="col-sm-7">@Model.Car.Year</dd>

                        <dt class="col-sm-5">Цена/день</dt>
                        <dd class="col-sm-7">@Model.Car.PricePerDay BYN</dd>

                        <dt class="col-sm-5">Статус</dt>
                        <dd class="col-sm-7">
                            @if (Model.Car.IsAvailable)
                            {
                                <span class="badge bg-success">Доступен</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Не доступен</span>
                            }
                        </dd>
                    </dl>

                    <div class="mt-4 d-flex gap-2">
                        <a asp-page="/Cars/Edit" asp-route-id="@Model.Car.Id" class="btn btn-warning">Редактировать</a>
                        <a asp-page="/Cars/Index" class="btn btn-secondary">Назад к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>